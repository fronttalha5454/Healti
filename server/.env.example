# Server Configuration
PORT=3001

# Canlı frontend adresi(leri): CORS izni (virgülle ayır). Boş = hepsi (sadece geliştirme)
# CORS_ORIGINS=https://healthi.vercel.app

# Firebase Admin (optional — for push notifications)
# Place service-account.json in this directory instead

# Resend Email Service
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Configuration
FROM_EMAIL=Healthi <onboarding@resend.dev>
APP_URL=http://localhost:5173

# ─── AI Koç ve Fotoğraf Analizi (Claude) ───
# Anahtar SADECE sunucuda durur, uygulamaya asla eklenmez.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here
# İsteğe bağlı: model (varsayılan claude-opus-5-5). Daha ucuz seçenek: claude-haiku-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
# İsteğe bağlı: uygulama da aynı değeri VITE_AI_CLIENT_TOKEN olarak gönderir (basit kötüye kullanım engeli)
# AI_CLIENT_TOKEN=uzun-rastgele-bir-deger
# İsteğe bağlı: IP başına dakikalık istek sınırı (varsayılan 20)
# AI_RATE_LIMIT_PER_MIN=20
