[TEMPLATE]
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Server (server/)
PORT=3001
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=Freebuff <onboarding@resend.dev>
APP_URL=http://localhost:5173

# Frontend API Base URL - configure for production deployment
VITE_API_BASE_URL=https://your-domain.com/api/v1

# Push Notification API URL
VITE_PUSH_API_URL=https://your-domain.com/api/v1


# AI proxy sunucusu (server/). Boş bırakılırsa AI Koç yerel motorla çalışır.
VITE_AI_API_URL=https://your-domain.com
# İsteğe bağlı: sunucudaki AI_CLIENT_TOKEN ile aynı değer
# VITE_AI_CLIENT_TOKEN=
