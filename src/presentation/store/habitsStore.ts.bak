import { create } from 'zustand';
import { persist } from 'zustand/middleware';
import type { DailyHabit, HabitLog, StepEntry } from '../types';

/** Unique habit id — Date.now() alone collides when several habits are created in the same ms */
const newHabitId = () => `habit_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

interface HabitsState {
  habits: DailyHabit[];
  habitLogs: HabitLog[];
  stepEntries: StepEntry[];
  stepGoal: number;

  // Habit CRUD
  addHabit: (name: string, icon: string) => void;
  removeHabit: (habitId: string) => void;
  toggleHabitActive: (habitId: string) => void;

  // Habit logging
  logHabit: (habitId: string, date: string, completed: boolean) => void;
  removeHabitLog: (logId: string) => void;

  // Per-habit completion queries
  getHabitLogForHabit: (date: string, habitId: string) => HabitLog | undefined;
  getHabitCompletionForDate: (date: string) => {
    total: number;
    completed: number;
    perHabitCompleted: Map<string, boolean>;
  };

  // Step tracking
  addSteps: (steps: number, date?: string) => void;
  removeStepEntry: (entryId: string) => void;
  setStepGoal: (goal: number) => void;

  // Queries
  getHabitLogsForDate: (date: string) => HabitLog[];
  getHabitCompletionForDate: (date: string) => { total: number; completed: number; perHabitCompleted: Map<string, boolean> };
  getStepTotalForDate: (date: string) => number;
  getStepEntriesForDate: (date: string) => StepEntry[];
  initializeDefaultHabits: () => void;
  getHabitSuggestions: () => {
    core: { name: string; icon: string }[];
    supplements: { name: string; icon: string }[];
  };
}

export const useHabitsStore = create<HabitsState>()(
  persist(
    (set, get) => ({
      habits: [],
      habitLogs: [],
      stepEntries: [],
      stepGoal: 8000,

      addHabit: (name, icon) =>
        set((state) => ({
          habits: [
            ...state.habits,
            {
              id: newHabitId(),
              name,
              icon,
              createdAt: new Date().toISOString(),
              active: true,
            },
          ],
        })),

      removeHabit: (habitId) =>
        set((state) => ({
          habits: state.habits.filter((h) => h.id !== habitId),
          habitLogs: state.habitLogs.filter((l) => l.habitId !== habitId),
        })),

      toggleHabitActive: (habitId) =>
        set((state) => ({
          habits: state.habits.map((h) =>
            h.id === habitId ? { ...h, active: !h.active } : h
          ),
        })),

      logHabit: (habitId, date, completed) =>
        set((state) => {
          // Check if log already exists for this habit+date
          const existing = state.habitLogs.find(
            (l) => l.habitId === habitId && l.date === date
          );
          if (existing) {
            return {
              habitLogs: state.habitLogs.map((l) =>
                l.id === existing.id ? { ...l, completed, timestamp: new Date().toISOString() } : l
              ),
            };
          }
          return {
            habitLogs: [
              ...state.habitLogs,
              {
                // Random suffix: two habits toggled in the same millisecond
                // must never share an id (collided ids made "mark one habit"
                // visually complete all of them)
                id: `habitlog_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
                habitId,
                date,
                completed,
                timestamp: new Date().toISOString(),
              },
            ],
          };
        }),

      removeHabitLog: (logId) =>
        set((state) => ({
          habitLogs: state.habitLogs.filter((l) => l.id !== logId),
        })),

      addSteps: (steps, date) =>
        set((state) => ({
          stepEntries: [
            ...state.stepEntries,
            {
              id: `step_${Date.now()}`,
              date: date || new Date().toISOString().split('T')[0],
              steps,
              timestamp: new Date().toISOString(),
            },
          ],
        })),

      removeStepEntry: (entryId) =>
        set((state) => ({
          stepEntries: state.stepEntries.filter((e) => e.id !== entryId),
        })),

      setStepGoal: (goal) => set({ stepGoal: goal }),

      getHabitLogsForDate: (date) => {
    return get().habitLogs.filter((l) => l.date === date);
  },
  getHabitLogForHabit: (date, habitId) => {
    return get()
      .habitLogs
      .find((l) => l.habitId === habitId && l.date === date);
  },

      getHabitCompletionForDate: (date) => {
        const { habits, habitLogs } = get();
        const activeHabits = habits.filter((h) => h.active);
        // Per-habit completed state: only count logs for the specific habit.
        // Previously this counted ALL completed logs across every habit, so
        // marking one habit as done marked all of them.
        const perHabitCompleted = new Map<string, boolean>();
        for (const activeHabit of activeHabits) {
          const habitLog = habitLogs.find(
            (l) => l.habitId === activeHabit.id && l.date === date && l.completed
          );
          perHabitCompleted.set(activeHabit.id, !!habitLog);
        }
        return {
          total: activeHabits.length,
          completed: Array.from(perHabitCompleted.values()).filter(Boolean).length,
          perHabitCompleted,
        };
      },

      getStepTotalForDate: (date) => {
        return get().stepEntries
          .filter((e) => e.date === date)
          .reduce((sum, e) => sum + e.steps, 0);
      },

      getStepEntriesForDate: (date) => {
        return get().stepEntries.filter((e) => e.date === date);
      },

      // Initialize default habits (only if none exist)
      initializeDefaultHabits: () => {
        const { habits } = get();
        // Repair persisted duplicate ids (older versions used bare Date.now(),
        // which collided for habits created in the same millisecond and made
        // toggling one habit mark all of them complete)
        if (habits.length > 0) {
          get().repairHabitIds();
          return;
        }
        const defaults = [
          { name: 'Su İç', icon: '💧' },
          { name: 'Yürüyüş', icon: '🚶' },
          { name: 'Esneme', icon: '🧘' },
          { name: 'Beslenme Kaydı', icon: '📝' },
          { name: 'Antrenman', icon: '🏋️' },
          { name: 'Erken Yatma', icon: '😴' },
        ];
        defaults.forEach((h) => {
          get().addHabit(h.name, h.icon);
        });
      },
      // Get habit suggestions (supplements are optional)
      getHabitSuggestions: () => {
        const { habits } = get();
        const existingNames = habits.map((h) => h.name.toLowerCase());
        const coreHabits = [
          { name: 'Su İç', icon: '💧' },
          { name: 'Yürüyüş', icon: '🚶' },
          { name: 'Esneme', icon: '🧘' },
          { name: 'Beslenme Kaydı', icon: '📝' },
          { name: 'Antrenman', icon: '🏋️' },
          { name: 'Erken Yatma', icon: '😴' },
        ];
        const supplementHabits = [
          { name: 'Kreatin', icon: '💊' },
          { name: 'Multivitamin', icon: '💊' },
          { name: 'Omega-3', icon: '🐟' },
          { name: 'Protein Tozu', icon: '🥤' },
          { name: 'D Vitamini', icon: '☀️' },
          { name: 'Magnesium', icon: '💊' },
        ];
        return {
          core: coreHabits.filter((h) => !existingNames.includes(h.name.toLowerCase())),
          supplements: supplementHabits.filter((h) => !existingNames.includes(h.name.toLowerCase())),
        };
      },

      // Repair persisted habit ids (older versions used bare Date.now(),
      // which collided for habits created in the same millisecond and made
      // toggling one habit mark all of them complete)
      repairHabitIds: () => {
        set((state) => {
          if (state.habits.length === 0) return state;
          const seen = new Set<string>();
          if (state.habits.some((h) => (seen.has(h.id) ? true : (seen.add(h.id), false)))) {
            const assigned = new Set<string>();
            return {
              ...state,
              habits: state.habits.map((h) => {
                let id = h.id;
                while (assigned.has(id)) id = newHabitId();
                assigned.add(id);
                return id === h.id ? h : { ...h, id };
              }),
            };
          }
          return state;
        });
      },


  }),
  {
    name: 'fitness-ai-habits',
  }
);
